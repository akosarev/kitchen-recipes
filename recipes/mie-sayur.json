{
  "id": "mie-sayur",
  "title": "Mie Goreng Sayur",
  "sub": "Fried noodles with just vegetables: zucchini, carrot and browned mushrooms.",
  "time": "about 25 min",
  "base": 3,
  "groups": [
    {
      "title": "Ingredients",
      "items": [
        {
          "k": "noodles",
          "q": 375,
          "u": "g",
          "n": "egg noodles (mie)"
        },
        {
          "k": "mushrooms",
          "q": 250,
          "u": "g",
          "n": "button mushrooms"
        },
        {
          "k": "zucchini",
          "q": 1,
          "u": "",
          "n": "medium zucchini"
        },
        {
          "k": "carrot",
          "q": 1,
