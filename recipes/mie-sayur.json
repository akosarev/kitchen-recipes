          "q": 5,
          "u": "cloves",
          "n": "garlic"
        },
        {
          "k": "shallot",
          "q": 3,
          "u": "",
          "n": "shallots"
        },
        {
          "k": "sprouts",
          "q": 150,
          "u": "g",
          "n": "bean sprouts"
        },
        {
          "k": "eggs",
          "q": 3,
          "u": "",
          "n": "eggs (optional)"
        },
        {
